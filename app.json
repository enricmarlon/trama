{
  "expo": {
    "name": "trama",
    "slug": "trama",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": "Permita que o Trama escolha fotos para os produtos da sua loja.",
          "cameraPermission": "Permita que o Trama use a câmera para fotografar os produtos."
        }
      ],
      "expo-sharing",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class androidx.work.impl.WorkDatabase_Impl { *; }"
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.anonymous.trama",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.trama"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "16f23e1a-6cc7-4b64-9dac-447466255260"
      }
    }
  }
}
